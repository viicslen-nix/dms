{
  lib,
  pkgs,
  config,
  inputs,
  osConfig ? {},
  ...
}: let
  stylixEnabled = (builtins.hasAttr "stylix" config) && config.stylix.enable;

  # Defaults to dms on a standalone home-manager eval, where the option is absent.
  enabled = (osConfig.modules.desktop.shell or "dms") == "dms";
in {
  imports = [
    inputs.dms.homeModules.niri
    inputs.dms.homeModules.dank-material-shell
    inputs.dms-plugin-registry.homeModules.default
  ];

  stylix.targets.dank-material-shell.enable = lib.mkIf stylixEnabled false;

  xdg.configFile."DankMaterialShell/themes/stylix.json" = lib.mkIf stylixEnabled {
    source = with config.lib.stylix.colors.withHashtag;
      pkgs.writers.writeJSON "custom-theme.json" {
        "name" = "Stylix";
        "primary" = base0C;
        "primaryText" = base00;
        "primaryContainer" = base0D;
        "secondary" = base0E;
        "surface" = base00;
        "surfaceText" = base05;
        "surfaceVariant" = base01;
        "surfaceVariantText" = base04;
        "surfaceTint" = base0C;
        "background" = base00;
        "backgroundText" = base07;
        "outline" = base03;
        "surfaceContainer" = base01;
        "surfaceContainerHigh" = base02;
        "error" = base08;
        "warning" = base0A;
        "info" = base0D;
      };
  };

  programs.dank-material-shell = {
    enable = enabled;
    systemd.enable = true;

    enableVPN = true; # VPN management widget
    enableCalendarEvents = true; # Calendar integration (khal)
    enableDynamicTheming = true; # Wallpaper-based theming (matugen)
    enableAudioWavelength = true; # Audio visualizer (cava)
    enableSystemMonitoring = true; # System monitoring widgets (dgop)

    plugins = {
      emojiLauncher.enable = true;
      dockerManager.enable = true;
      screenshotToggle.enable = true;
      linuxWallpaperEngine.enable = true;
      dankPinentry.enable = true;
    };

    niri.includes = {
      # Rewrites niri's config.kdl, so it must stay off when another shell runs.
      enable = enabled;

      override = true; # If disabled, DMS settings won't be prioritized over settings defined using niri-flake
      originalFileName = "hm"; # A new name (without extension) for the config file generated by niri-flake.
      filesToInclude = [
        "binds"
        "alttab"
        "wpblur"
        "colors"
        "layout"
        "outputs"
        "windowrules"
      ];
    };
  };

  # desktop-shell.target is declared by modules/nixos/desktop/shell; compositors
  # start it without naming a shell, so binding here is what autostarts dms.
  systemd.user.services.dms = lib.mkIf enabled {
    Unit = {
      PartOf = lib.mkForce ["desktop-shell.target"];
      After = lib.mkForce [];
    };
    Install.WantedBy = lib.mkForce ["desktop-shell.target"];
  };
}
